.wwebjs_cache/
.wwebjs_auth_baileys/

# Biometric / Voice data (SENSITIVE)
biometric_config.json
biometric_sample_*.wav
mizune_voice_profile.npy
record_biometric.py

# Character assets (too large for git)
character/*.vrm
character/*.vroid

# QR Codes / Auth tokens
qr_code.txt

# Temp execution files
.temp_exec.py
test_output.txt

# Kernel events DB
kernel_events.db

# MizuneVault (personal notes)
MizuneVault/

# Vault Sync Exports (SENSITIVE)
Sources/
Knowledge/
Daily/
contacts.json
.env

# Mobile and Android
*.hprof
.gradle/
local.properties
*.tar


build/
app/build/


# Vosk offline wake-word model (local asset, ~45MB — bundled into APK at build, not committed)
mizune-android/app/src/main/assets/vosk-model-en/

# Picovoice custom keyword (Rushi generates; local asset, not committed)
mizune-android/app/src/main/assets/baka_mizune.ppn

