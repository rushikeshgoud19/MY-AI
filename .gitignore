# Exclude environment variables and virtual environments
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd

# Exclude node_modules
node_modules/
dist/

# Exclude logs
*.log
renderer.log
server_crash.log
server_debug.log
voices_output.txt
voices_output_utf8.txt

# Exclude OS-specific files
.DS_Store
Thumbs.db

# Exclude VS Code settings
.vscode/

# Exclude config with API keys — use config.example.json as template
config.json

# Exclude temp debug files
temp_*.txt
last_err.txt
server_debug_ascii.txt
server_debug_utf8.log

# Exclude local databases and caches
.chroma_db/
.claude/
.data/
legacy/lumina/
legacy/server_old.py
package-lock.json
tts_cache/
dataset/
# Anchored: a bare `data/` matches ANY directory named data at any depth, which
# silently excluded the Android app's com/mizune/app/data package from the repo.
/data/
data_collector/
*.db
src-tauri/target/

# Local archives (docker image tars etc.) — never commit
_archive/

# Graphify knowledge graph output (regenerate with: graphify update .)
graphify-out/
.wwebjs_auth/
.wwebjs_cache/
.wwebjs_auth_baileys/

# Biometric / Voice data (SENSITIVE)
biometric_config.json
biometric_sample_*.wav
mizune_voice_profile.npy
record_biometric.py

# Character assets (too large for git)
character/*.vrm
character/*.vroid

# QR Codes / Auth tokens
qr_code.txt

# Temp execution files
.temp_exec.py
test_output.txt

# Kernel events DB
kernel_events.db

# MizuneVault (personal notes)
MizuneVault/

# Vault Sync Exports (SENSITIVE)
Sources/
Knowledge/
Daily/
contacts.json
.env

# Mobile and Android
*.hprof
.gradle/
local.properties
*.tar


build/
app/build/


# Vosk offline wake-word model (local asset, ~45MB — bundled into APK at build, not committed)
mizune-android/app/src/main/assets/vosk-model-en/

# Picovoice custom keyword (Rushi generates; local asset, not committed)
mizune-android/app/src/main/assets/baka_mizune.ppn

# Z3.1 SOVEREIGN self-export archives + restores (contain her memory DBs — personal data,
# regenerable via scripts/mizune_export.py; never commit)
mizune_self*.tar.gz
*.mizune_self.tar.gz
mizune_restore*/

# --- Config backups -------------------------------------------------------
# config.json is ignored above, but every .bak of it carries the SAME live keys.
config.json.*
biometric_config.json.*
*.bak
*.bak_*

