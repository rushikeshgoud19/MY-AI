# Replace mizune.yourdomain.com with your actual domain.
# Caddy will automatically obtain and renew a Let's Encrypt certificate.
mizune.yourdomain.com {
    # WebSocket endpoint for mobile/dashboard real-time connection
    reverse_proxy /ws localhost:8001

    # REST API endpoints (transcribe, chat, etc.)
    reverse_proxy /api/* localhost:8000

    # Static frontend and SPA fallback
    reverse_proxy localhost:8000
}
